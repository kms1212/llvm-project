# RUN: llc -mtriple=bedrock -run-pass=bedrock-pre-emit-peephole -verify-machineinstrs %s -o - | FileCheck %s

# REQUIRES: bedrock-registered-target

--- |
  target triple = "bedrock"

  @byte_sink = external global i8
  @counter = external global i64
  @cmp_symbol = external global i8

  declare i64 @callee(i64)

  define i64 @redundant_frame_store() {
    ret i64 0
  }

  define void @killed_frame_store() {
    ret void
  }

  define i32 @shl_one_flags_dead() {
    ret i32 0
  }

  define i32 @shift_or_one_flags_dead() {
    ret i32 0
  }

  define i32 @shift_bset_zero_flags_dead() {
    ret i32 0
  }

  define i32 @shift_bset_zero_flags_live() {
    ret i32 0
  }

  define void @shifted_load_byte_store() {
    ret void
  }

  define i32 @divrem_decomposition() {
    ret i32 0
  }

  define i32 @shift_mask_byte_extend() {
    ret i32 0
  }

  define i64 @shift_mask_byte_extend_after_copy() {
    ret i64 0
  }

  define i64 @retained_load_mem_incdec() {
    ret i64 0
  }

  define i64 @reloaded_mem_incdec() {
    ret i64 0
  }

  define i64 @reloaded_liveout_mem_incdec() {
    ret i64 0
  }

  define void @dead_mem_incdec() {
    ret void
  }

  define i32 @positive_one_imm_lt_branch() {
    ret i32 0
  }

  define i32 @positive_one_imm_ge_setcc() {
    ret i32 0
  }

  define i32 @zero_compare_eq_with_gap() {
    ret i32 0
  }

  define i32 @zero_compare_redefined_before_branch() {
    ret i32 0
  }

  define i32 @materialized_const_cmp_branch() {
    ret i32 0
  }

  define i32 @materialized_symbol_cmp_branch() {
    ret i32 0
  }

  define i32 @materialized_one_cmp_not_folded() {
    ret i32 0
  }

  define i32 @redundant_self_and_flags_dead() {
    ret i32 0
  }

  define i32 @self_and_flags_live() {
    ret i32 0
  }

  define i64 @two_stage_zext_byte() {
    ret i64 0
  }

  define i64 @two_stage_sext_word() {
    ret i64 0
  }

  define i64 @andl_zextq() {
    ret i64 0
  }

  define i64 @andl_negative_mask_zextq() {
    ret i64 0
  }

  define i64 @known_zero_high_local() {
    ret i64 0
  }

  define i64 @known_zero_high_arg(i32 zeroext %x) {
    ret i64 0
  }

  define i64 @known_zero_high_cross_block() {
    ret i64 0
  }

  define i64 @known_zero_high_copy_extend() {
    ret i64 0
  }

  define i64 @known_zero_high_copy_extend_caller_saved_call() {
    ret i64 0
  }

  define i64 @known_zero_high_long_ops_stay_canonical() {
    ret i64 0
  }

  define i64 @unknown_high_arg(i32 %x) {
    ret i64 0
  }

  define i64 @smax_zero_signext_arg(i32 signext %x) {
    ret i64 0
  }

  define i64 @smax_zero_unknown_arg(i32 %x) {
    ret i64 0
  }

  define i64 @smax_zero_signext_readonly_bound(ptr %p, i32 signext %x) {
    ret i64 0
  }

  define i64 @smax_zero_signext_mutated_bound(ptr %p, i32 signext %x) {
    ret i64 0
  }

  define i32 @smax_zero_reuses_known_zero() {
    ret i32 0
  }

  define i32 @smin_zero_reuses_known_zero() {
    ret i32 0
  }

  define i32 @deferred_lea_copy_after_self_load_cmp() {
    ret i32 0
  }

  define i64 @andl_known_zero_operand_zextq() {
    ret i64 0
  }

  define i64 @andl_known_zero_operand_flags_live() {
    ret i64 0
  }

  define i64 @andl_entry_zero_ext_operand_zextq() {
    ret i64 0
  }

  define i32 @commutative_or_copy_i32_return() {
    ret i32 0
  }

  define i32 @commutative_copy_preserves_load_fold() {
    ret i32 0
  }

  define i32 @sink_select_false_immediate() {
    ret i32 0
  }

  define i32 @hex_digit_select_fold() {
    ret i32 0
  }

  define i32 @hex_digit_pair_post_extend_fold() {
    ret i32 0
  }

  define i32 @callee_saved_pair_pushpop() {
    ret i32 0
  }

  define i32 @callee_saved_single_pushpop() {
    ret i32 0
  }

  define i32 @callee_saved_pair_keeps_unpaired_top_slot() {
    ret i32 0
  }

  define i32 @callee_saved_pair_with_unpaired_r14() {
    ret i32 0
  }

  define i32 @callee_saved_padding_pair() {
    ret i32 0
  }

  define i32 @callee_saved_padding_pair_r14() {
    ret i32 0
  }

  define i32 @callee_saved_frame_padding_pair() {
    ret i32 0
  }

  define i32 @callee_saved_frame_padding_keeps_low_offset() {
    ret i32 0
  }

  define i32 @callee_saved_padding_keeps_frame_access() {
    ret i32 0
  }

  define i32 @tail_call_wrapper() {
    ret i32 0
  }

  define i32 @tail_call_after_epilogue() {
    ret i32 0
  }

  define i32 @unmarked_call_is_not_tail() {
    ret i32 0
  }

  define i64 @callee_saved_constant_reuse() {
    ret i64 0
  }

  define void @zero_reuse_before_second_clear() {
    ret void
  }

  define i64 @zero_reuse_keeps_later_original_use() {
    ret i64 0
  }

  define void @zero_store_immediate() {
    ret void
  }

  define void @zero_store_keeps_address_use() {
    ret void
  }

  define i64 @zero_return_callee_saved_phi() {
    ret i64 0
  }

  define void @remove_fallthrough_branch() {
    ret void
  }

  define void @materialized_scaled_index_store() {
    ret void
  }

  define void @wrong_materialized_scale_store() {
    ret void
  }

  define i64 @materialized_shift_mask_byte() {
    ret i64 0
  }
...
---
name:            redundant_frame_store
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: redundant_frame_store
    ; CHECK: $r1 = LOADQfi 24, 0
    ; CHECK-NEXT: CALL @callee
    ; CHECK-NOT: STOREQfi $r1, 24, 0
    $r1 = LOADQfi 24, 0
    STOREQfi $r1, 24, 0
    CALL @callee, csr_bedrock, implicit-def $r0, implicit-def dead $r1, implicit-def dead $r2, implicit-def dead $r3, implicit-def dead $r4, implicit-def dead $r5, implicit-def dead $r6, implicit-def dead $r7, implicit-def dead $f0, implicit-def dead $f1, implicit-def dead $f2, implicit-def dead $f3, implicit-def dead $f4, implicit-def dead $f5, implicit-def dead $f6, implicit-def dead $f7, implicit $r1
    RET implicit $r0
...
---
name:            killed_frame_store
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: killed_frame_store
    ; CHECK: $r1 = LOADQfi 24, 0
    ; CHECK-NEXT: STOREQfi killed $r1, 24, 0
    $r1 = LOADQfi 24, 0
    STOREQfi killed $r1, 24, 0
    RET
...
---
name:            shl_one_flags_dead
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: shl_one_flags_dead
    ; CHECK: $r1 = nuw nsw ADDL3rr $r1, killed $r1
    ; CHECK: bb.1:
    successors: %bb.1
    liveins: $r1

    $r1 = nuw nsw SHLL3ri killed $r1, 1

  bb.1:
    liveins: $r0, $r1

    $r0 = ADDL3rr killed $r0, $r1
    RET implicit $r0
...
---
name:            shift_or_one_flags_dead
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: shift_or_one_flags_dead
    ; CHECK: $r1 = nuw nsw SHLL3ri killed $r1, 2
    ; CHECK-NEXT: $r1 = disjoint INCL3r killed $r1
    ; CHECK-NEXT: $r0 = ADDL3rr killed $r0, $r1
    liveins: $r0, $r1

    $r1 = nuw nsw SHLL3ri killed $r1, 2
    $r1 = disjoint ORL3ri killed $r1, 1
    $r0 = ADDL3rr killed $r0, $r1
    RET implicit $r0
...
---
name:            shift_bset_zero_flags_dead
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: shift_bset_zero_flags_dead
    ; CHECK: $r1 = nuw nsw SHLL3ri killed $r1, 2
    ; CHECK-NEXT: $r1 = disjoint INCL3r killed $r1
    ; CHECK-NEXT: $r0 = ADDL3rr killed $r0, $r1
    liveins: $r0, $r1

    $r1 = nuw nsw SHLL3ri killed $r1, 2
    $r1 = disjoint BSETL3ri killed $r1, 0, implicit-def dead $flags
    $r0 = ADDL3rr killed $r0, $r1
    RET implicit $r0
...
---
name:            shift_bset_zero_flags_live
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: shift_bset_zero_flags_live
    ; CHECK: $r1 = nuw nsw SHLL3ri killed $r1, 2
    ; CHECK-NEXT: $r1 = disjoint BSETL3ri killed $r1, 0, implicit-def $flags
    ; CHECK-NEXT: $r0 = SETCC 3, implicit $flags
    ; CHECK-NOT: INCL3r
    liveins: $r1

    $r1 = nuw nsw SHLL3ri killed $r1, 2
    $r1 = disjoint BSETL3ri killed $r1, 0, implicit-def $flags
    $r0 = SETCC 3, implicit $flags
    RET implicit $r0
...
---
name:            shifted_load_byte_store
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: shifted_load_byte_store
    ; CHECK: $r1 = LOADB_Zro $r0, 33
    ; CHECK-NEXT: STOREBabs killed $r1, @byte_sink
    ; CHECK-NOT: SHRQ3ri
    liveins: $r0

    $r1 = LOADQro $r0, 32
    $r1 = SHRQ3ri killed $r1, 8
    STOREBabs killed $r1, @byte_sink
    RET
...
---
name:            divrem_decomposition
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: divrem_decomposition
    ; CHECK: $r8 = MOVQrr $r7
    ; CHECK-NEXT: $r8 = DIVSL3rr killed $r8, $r2
    ; CHECK-NEXT: $r7 = MODSL3rr killed $r7, $r2
    ; CHECK-NEXT: $r8 = ADDL3rr killed $r8, killed $r7
    ; CHECK-NEXT: $r0 = MOVQrr killed $r8
    ; CHECK-NOT: MULL3rr
    liveins: $r2, $r7

    $r8 = MOVQrr $r7
    $r8 = DIVSL3rr killed $r8, $r2
    $r9 = MOVQrr $r8
    $r9 = MULL3rr killed $r9, $r2
    $r7 = SUBL3rr killed $r7, killed $r9
    $r8 = ADDL3rr killed $r8, killed $r7
    $r0 = MOVQrr killed $r8
    RET implicit $r0
...
---
name:            shift_mask_byte_extend
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: shift_mask_byte_extend
    ; CHECK: $r0 = MOVBrr killed $r0
    ; CHECK-NEXT: $r0 = SHLL3ri killed $r0, 8
    ; CHECK-NEXT: $r0 = ORL3rr killed $r0, killed $r1
    ; CHECK-NOT: ANDL3ri
    liveins: $r0, $r1

    $r0 = nuw nsw SHLL3ri killed $r0, 8
    $r0 = ANDL3ri killed $r0, 65280
    $r0 = ORL3rr killed $r0, killed $r1
    RET implicit $r0
...
---
name:            shift_mask_byte_extend_after_copy
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: shift_mask_byte_extend_after_copy
    ; CHECK-NOT: MOVQrr
    ; CHECK: $r0 = MOVBrr $r1
    ; CHECK-NEXT: $r0 = SHLL3ri killed $r0, 3
    ; CHECK-NOT: ANDL3ri
    ; CHECK-NOT: MOVLrr
    liveins: $r1

    $r0 = MOVQrr $r1
    $r0 = SHLL3ri killed $r0, 3
    $r0 = ANDL3ri killed $r0, 2040
    $r0 = MOVLrr killed $r0
    RET implicit $r0
...
---
name:            retained_load_mem_incdec
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: retained_load_mem_incdec
    ; CHECK: $r6 = CONST64 @counter
    ; CHECK-NEXT: $r2 = LOADQro $r6, 0
    ; CHECK-NEXT: INCQmo $r6, 0
    ; CHECK-NEXT: TESTQrr $r2, $r2
    ; CHECK-NOT: INCQ3r
    ; CHECK-NOT: STOREQabs

    $r2 = LOADQabs @counter
    $r3 = MOVQrr $r2
    $r3 = INCQ3r killed $r3
    STOREQabs killed $r3, @counter
    TESTQrr $r2, $r2, implicit-def $flags
    RET implicit $r2
...
---
name:            reloaded_mem_incdec
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: reloaded_mem_incdec
    ; CHECK: $r6 = CONST64 @counter
    ; CHECK-NEXT: INCQmo $r6, 0
    ; CHECK-NEXT: $r2 = LOADQro $r6, 0
    ; CHECK-NEXT: TESTQrr $r2, $r2
    ; CHECK-NEXT: RET implicit $r2

    $r2 = LOADQabs @counter
    $r2 = INCQ3r killed $r2
    STOREQabs $r2, @counter
    TESTQrr $r2, $r2, implicit-def $flags
    RET implicit $r2
...
---
name:            reloaded_liveout_mem_incdec
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: reloaded_liveout_mem_incdec
    ; CHECK: $r6 = CONST64 @counter
    ; CHECK-NEXT: INCQmo $r6, 0
    ; CHECK-NEXT: $r2 = LOADQro $r6, 0
    ; CHECK-NEXT: TESTQrr $r1, $r1
    ; CHECK-NEXT: BRCC %bb.2, 2
    successors: %bb.1, %bb.2
    liveins: $r1

    $r2 = LOADQabs @counter
    $r2 = INCQ3r killed $r2
    STOREQabs $r2, @counter
    TESTQrr $r1, $r1, implicit-def $flags
    BRCC %bb.2, 2, implicit $flags

  bb.1:
    liveins: $r1

    RET implicit $r1

  bb.2:
    liveins: $r2

    RET implicit $r2
...
---
name:            dead_mem_incdec
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: dead_mem_incdec
    ; CHECK: INCQabs @counter
    ; CHECK-NEXT: RET

    $r2 = LOADQabs @counter
    $r2 = INCQ3r killed $r2
    STOREQabs $r2, @counter
    RET
...
---
name:            positive_one_imm_lt_branch
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: positive_one_imm_lt_branch
    ; CHECK: TESTLrr $r1, $r1
    ; CHECK-NEXT: BRCC %bb.1, 14
    ; CHECK-NOT: CMPLri
    successors: %bb.1
    liveins: $r1

    CMPLri $r1, 1, implicit-def $flags
    BRCC %bb.1, 12, implicit $flags

  bb.1:
    $r0 = CONST32 0
    RET implicit $r0
...
---
name:            positive_one_imm_ge_setcc
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: positive_one_imm_ge_setcc
    ; CHECK: TESTQrr $r1, $r1
    ; CHECK-NEXT: $r0 = SETCC 15
    ; CHECK-NOT: CMPQri
    liveins: $r1

    CMPQri $r1, 1, implicit-def $flags
    $r0 = SETCC 13, implicit $flags
    RET implicit $r0
...
---
name:            zero_compare_eq_with_gap
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: zero_compare_eq_with_gap
    ; CHECK-NOT: CONST64 0
    ; CHECK: $r1 = MOVQrr killed $r3
    ; CHECK-NEXT: TESTQrr $r1, $r1
    ; CHECK-NEXT: BRCC %bb.1, 2
    successors: %bb.1
    liveins: $r3

    $r2 = CONST64 0
    $r1 = MOVQrr killed $r3
    CMPQrr killed $r2, $r1, implicit-def $flags
    BRCC %bb.1, 2, implicit $flags

  bb.1:
    $r0 = CONST32 0
    RET implicit $r0
...
---
name:            zero_compare_redefined_before_branch
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: zero_compare_redefined_before_branch
    ; CHECK-NOT: CONST64 0
    ; CHECK: TESTQrr $r2, $r2
    ; CHECK-NEXT: $r1 = MOVQrr killed $r0
    ; CHECK-NEXT: BRCC %bb.1, 2
    successors: %bb.1
    liveins: $r0, $r2

    $r1 = CONST64 0
    CMPQrr $r1, $r2, implicit-def $flags
    $r1 = MOVQrr killed $r0
    BRCC %bb.1, 2, implicit $flags

  bb.1:
    $r0 = CONST32 0
    RET implicit $r0
...
---
name:            materialized_const_cmp_branch
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: materialized_const_cmp_branch
    ; CHECK-NOT: CONST32 10
    ; CHECK: CMPLri killed $r1, 10
    ; CHECK-NEXT: BRCC %bb.1, 10
    successors: %bb.1
    liveins: $r1

    $r3 = CONST32 10
    CMPLrr killed $r3, killed $r1, implicit-def $flags
    BRCC %bb.1, 10, implicit $flags

  bb.1:
    $r0 = CONST32 0
    RET implicit $r0
...
---
name:            materialized_symbol_cmp_branch
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: materialized_symbol_cmp_branch
    ; CHECK-NOT: CONST64 @cmp_symbol
    ; CHECK: CMPQri killed $r1, @cmp_symbol
    ; CHECK-NEXT: BRCC %bb.1, 2
    successors: %bb.1
    liveins: $r1

    $r3 = CONST64 @cmp_symbol
    CMPQrr killed $r3, killed $r1, implicit-def $flags
    BRCC %bb.1, 2, implicit $flags

  bb.1:
    $r0 = CONST32 0
    RET implicit $r0
...
---
name:            materialized_one_cmp_not_folded
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: materialized_one_cmp_not_folded
    ; CHECK: $r3 = CONST32 1
    ; CHECK-NEXT: CMPLrr killed $r3, killed $r1
    successors: %bb.1
    liveins: $r1

    $r3 = CONST32 1
    CMPLrr killed $r3, killed $r1, implicit-def $flags
    BRCC %bb.1, 10, implicit $flags

  bb.1:
    $r0 = CONST32 0
    RET implicit $r0
...
---
name:            redundant_self_and_flags_dead
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: redundant_self_and_flags_dead
    ; CHECK-NOT: ANDQ3rr
    ; CHECK: $r0 = ADDQ3rr killed $r0, $r1
    ; CHECK-NEXT: RET implicit $r0
    liveins: $r0, $r1

    $r1 = ANDQ3rr $r1, $r1
    $r0 = ADDQ3rr killed $r0, $r1
    RET implicit $r0
...
---
name:            self_and_flags_live
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: self_and_flags_live
    ; CHECK-NOT: ANDQ3rr
    ; CHECK: BRCC %bb.1, 2
    successors: %bb.1
    liveins: $r1

    $r1 = ANDQ3rr $r1, $r1
    BRCC %bb.1, 2, implicit $flags

  bb.1:
    liveins: $r1

    $r0 = MOVQrr killed $r1
    RET implicit $r0
...
---
name:            two_stage_zext_byte
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: two_stage_zext_byte
    ; CHECK: $r0 = MOVBrr killed $r1
    ; CHECK-NEXT: RET implicit $r0
    ; CHECK-NOT: MOVLrr
    liveins: $r1

    $r2 = MOVBrr killed $r1
    $r0 = MOVLrr killed $r2
    RET implicit $r0
...
---
name:            two_stage_sext_word
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: two_stage_sext_word
    ; CHECK: $r0 = EXTSQWrr killed $r1
    ; CHECK-NEXT: RET implicit $r0
    ; CHECK-NOT: EXTSQLrr
    liveins: $r1

    $r2 = EXTSQWrr killed $r1
    $r0 = EXTSQLrr killed $r2
    RET implicit $r0
...
---
name:            andl_zextq
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: andl_zextq
    ; CHECK: $r0 = ANDL3ri killed $r0, 2040
    ; CHECK-NEXT: RET implicit $r0
    ; CHECK-NOT: MOVLrr
    liveins: $r0

    $r0 = ANDL3ri killed $r0, 2040
    $r0 = MOVLrr killed $r0
    RET implicit $r0
...
---
name:            andl_negative_mask_zextq
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: andl_negative_mask_zextq
    ; CHECK: $r0 = ANDL3ri killed $r0, -2
    ; CHECK-NEXT: RET implicit $r0
    ; CHECK-NOT: MOVLrr
    liveins: $r0

    $r0 = ANDL3ri killed $r0, -2
    $r0 = MOVLrr killed $r0
    RET implicit $r0
...
---
name:            known_zero_high_local
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: known_zero_high_local
    ; CHECK: $r0 = MOVBrr killed $r1
    ; CHECK-NEXT: $r0 = SHLL3ri killed $r0, 3
    ; CHECK-NEXT: RET implicit $r0
    ; CHECK-NOT: MOVLrr
    liveins: $r1

    $r0 = MOVBrr killed $r1
    $r0 = SHLL3ri killed $r0, 3
    $r0 = MOVLrr killed $r0
    RET implicit $r0
...
---
name:            known_zero_high_arg
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: known_zero_high_arg
    ; CHECK: $r0 = SHLL3ri killed $r0, 3
    ; CHECK-NEXT: RET implicit $r0
    ; CHECK-NOT: MOVLrr
    liveins: $r0

    $r0 = SHLL3ri killed $r0, 3
    $r0 = MOVLrr killed $r0
    RET implicit $r0
...
---
name:            known_zero_high_cross_block
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: known_zero_high_cross_block
    ; CHECK: $r9 = CONST64 0
    ; CHECK: bb.1:
    ; CHECK: $r1 = MOVQrr $r9
    ; CHECK-NEXT: $r1 = ANDL3ri killed $r1, 3
    ; CHECK-NEXT: $r1 = INCL3r killed $r1
    ; CHECK-NOT: $r1 = MOVLrr
    ; CHECK-NEXT: RET implicit $r1
    successors: %bb.1

    $r9 = CONST64 0
    BR %bb.1

  bb.1:
    liveins: $r9

    $r1 = MOVQrr $r9

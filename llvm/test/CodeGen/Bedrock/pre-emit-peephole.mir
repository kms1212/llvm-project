    liveins: $r8

    ADJSP_DOWN 16
    STOREQfi killed $r8, 8, 0
    $r8 = CONST64 0
    $r0 = CONST64 0
    CALL @callee, csr_bedrock, implicit-def $r0, implicit-def dead $r1, implicit-def dead $r2, implicit-def dead $r3, implicit-def dead $r4, implicit-def dead $r5, implicit-def dead $r6, implicit-def dead $r7, implicit-def dead $f0, implicit-def dead $f1, implicit-def dead $f2, implicit-def dead $f3, implicit-def dead $f4, implicit-def dead $f5, implicit-def dead $f6, implicit-def dead $f7, implicit $r0

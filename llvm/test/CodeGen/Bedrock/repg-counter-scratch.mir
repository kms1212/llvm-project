# RUN: llc -mtriple=bedrock -run-pass=bedrock-pre-emit-peephole -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=MIR
# RUN: llc -mtriple=bedrock -start-before=bedrock-pre-emit-peephole -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ASM

# REQUIRES: bedrock-registered-target

--- |
  target triple = "bedrock"

  define i32 @repg_counter_scratch(ptr %out, ptr %in, i32 %n,
                                   i32 %c0, i32 %c1, i32 %c2) {
    ret i32 0
  }
...
---
name:            repg_counter_scratch
tracksRegLiveness: true
noVRegs:         true
body:             |
  ; MIR-LABEL: name: repg_counter_scratch
  ; MIR-NOT: PUSHr
  ; MIR: REPG_SCRATCH $r6
  ; MIR: $r6 = LOADLro $r1, -8
  ; MIR: $r6 = MULL3rr $r6, $r3
  ; MIR: $r7 = ADDL3rr killed $r7, $r6
  ; MIR-NOT: $r8
  ; MIR-NOT: POPr

  ; ASM-LABEL: repg_counter_scratch:
  ; ASM-NOT: push
  ; ASM: repg r6, {
  ; ASM: mov.l r3, r6
  ; ASM: mul.l [r1 - 8], r6
  ; ASM: add.l r6, r7
  ; ASM: }
  ; ASM-NOT: pop
  ; ASM: ret
  bb.0:
    successors: %bb.1
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r8

    PUSHr killed $r8
    $r6 = EXTZQLrr $r2
    BR %bb.1

  bb.1:
    successors: %bb.3(0x04000000), %bb.2(0x7c000000)
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r6

    TESTQrr $r6, $r6, implicit-def $flags
    BRCC %bb.3, 2, implicit $flags

  bb.2:
    successors: %bb.1
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r6

    $r7 = LOADLro $r1, -4
    $r7 = MULL3rr killed $r7, $r4
    $r8 = LOADLro $r1, -8
    $r8 = MULL3rr killed $r8, $r3
    $r8 = ADDL3rr killed $r8, killed $r7
    $r7 = LOADLrr $r1
    $r7 = MULL3rr killed $r7, $r5
    $r7 = ADDL3rr killed $r7, killed $r8
    STORELrr killed $r7, $r0
    $r1 = LEAro killed $r1, 4
    $r0 = LEAro killed $r0, 4
    $r6 = DECQ3r killed $r6
    BR %bb.1

  bb.3:
    liveins: $r2, $r8

    $r0 = MOVQrr killed $r2
    $r8 = POPr
    RET implicit $r0
...

# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: shr_high_and32
# CHECK:       $d3 = SHR64ri
# CHECK-NEXT:  $d3 = AND32ri {{.*}}$d3, 268435448

# CHECK-LABEL: name: shr_low_negative
# CHECK:       $d3 = SHR64ri
# CHECK-NEXT:  $d3 = AND64ri {{.*}}$d3, 268435448

# CHECK-LABEL: name: shr_high_and_flags_live_negative
# CHECK:       $d3 = SHR64ri
# CHECK-NEXT:  $d3 = AND64ri {{.*}}$d3, 268435448
# CHECK-NEXT:  JCC

--- |
  target triple = "bedrock"

  define void @shr_high_and32() {
    ret void
  }

  define void @shr_low_negative() {
    ret void
  }

  define void @shr_high_and_flags_live_negative() {
    ret void
  }
...
---
name: shr_high_and32
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d3

    $d3 = SHR64ri killed $d3, 36, implicit-def dead $flags
    $d3 = AND64ri killed $d3, 268435448, implicit-def dead $flags
    RET implicit $d3, implicit $sp
...
---
name: shr_low_negative
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d3

    $d3 = SHR64ri killed $d3, 27, implicit-def dead $flags
    $d3 = AND64ri killed $d3, 268435448, implicit-def dead $flags
    RET implicit $d3, implicit $sp
...
---
name: shr_high_and_flags_live_negative
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $d3

    $d3 = SHR64ri killed $d3, 36, implicit-def dead $flags
    $d3 = AND64ri killed $d3, 268435448, implicit-def $flags
    JCC %bb.1, 1, implicit $flags

  bb.1:
    liveins: $d3

    RET implicit $d3, implicit $sp
...

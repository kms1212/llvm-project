# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: load_self_test_eq
# CHECK:       CMP32mi 0, $a0, 12
# CHECK-NOT:   MOV32rm
# CHECK-NOT:   TEST32rr

# CHECK-LABEL: name: indexed_load_self_test_ne
# CHECK:       CMP8idx1mi 0, $sp, $d1, 20
# CHECK-NOT:   MOV8idx1rm
# CHECK-NOT:   TEST8rr

# CHECK-LABEL: name: signed_condition_negative
# CHECK:       $d0 = MOV32rm $a0, 0
# CHECK-NEXT:  TEST32rr killed $d0, $d0
# CHECK-NEXT:  JCC %bb.{{[0-9]+}}, 12
# CHECK-NOT:   CMP32mi 0, $a0, 0

--- |
  target triple = "bedrock"

  define void @load_self_test_eq() {
    ret void
  }

  define void @indexed_load_self_test_ne() {
    ret void
  }

  define void @signed_condition_negative() {
    ret void
  }
...
---
name: load_self_test_eq
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $a0

    $d0 = MOV32rm $a0, 12 :: (load (s32))
    TEST32rr killed $d0, $d0, implicit-def $flags
    JCC %bb.1, 2, implicit killed $flags

  bb.2:
    RET implicit $sp

  bb.1:
    RET implicit $sp
...
---
name: indexed_load_self_test_ne
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $d1

    $d0 = MOV8idx1rm $sp, $d1, 20 :: (load (s8))
    TEST8rr killed $d0, $d0, implicit-def $flags
    JCC %bb.1, 3, implicit killed $flags

  bb.2:
    RET implicit $sp

  bb.1:
    RET implicit $sp
...
---
name: signed_condition_negative
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $a0

    $d0 = MOV32rm $a0, 0 :: (load (s32))
    TEST32rr killed $d0, $d0, implicit-def $flags
    JCC %bb.1, 12, implicit killed $flags

  bb.2:
    RET implicit $sp

  bb.1:
    RET implicit $sp
...

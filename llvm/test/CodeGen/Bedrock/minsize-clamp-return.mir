# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: signed_clamp_return
# CHECK-NOT:   MOVCC32rr
# CHECK:       $d0 = MAXS32rr $d0, $d1
# CHECK-NEXT:  $d0 = MINS32rr $d0, $d2
# CHECK-NEXT:  RET implicit $sp, implicit $d0

--- |
  target triple = "bedrock"

  define i32 @signed_clamp_return(i32 %value, i32 %lo, i32 %hi) #0 {
    ret i32 %value
  }

  attributes #0 = { minsize optsize }
...
---
name: signed_clamp_return
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d0, $d1, $d2

    $d2 = MINS32rr killed $d2, $d0
    CMP32rr killed $d0, $d1, implicit-def $flags
    $d2 = MOVCC32rr killed $d2, killed $d1, 12, implicit $flags
    $d0 = MOV64rr killed $d2
    RET implicit $sp, implicit $d0
...

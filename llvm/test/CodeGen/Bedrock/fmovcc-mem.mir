# RUN: llc -mtriple=bedrock -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: fmovcc_mem:
# CHECK:       FMOVEQ.S [A0], F0
# CHECK-NEXT:  FMOVNE.D F1, [A0 + 8]
# CHECK-NEXT:  RET

--- |
  target triple = "bedrock"

  define void @fmovcc_mem() {
    ret void
  }
...
---
name: fmovcc_mem
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0, $f0, $f1

    $f0 = FMOVCC32rm $f0, $a0, 0, 2, implicit $flags
    FMOVCC64mr $f1, $a0, 8, 3, implicit $flags
    RET implicit $sp
...

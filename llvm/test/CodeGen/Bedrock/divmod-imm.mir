# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: divmod_imm
# CHECK:       $d0 = DIVU32ri $d0, 20
# CHECK:       $d1 = MODU32ri $d1, 20
# CHECK:       $d2 = DIVS32ri $d2, -7
# CHECK:       $d3 = MODS32ri $d3, -7

--- |
  target triple = "bedrock"

  define void @divmod_imm() #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: divmod_imm
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d0, $d1, $d2, $d3

    $d0 = DIVU32ri $d0, 20
    $d1 = MODU32ri $d1, 20
    $d2 = DIVS32ri $d2, -7
    $d3 = MODS32ri $d3, -7
    RET implicit $sp
...

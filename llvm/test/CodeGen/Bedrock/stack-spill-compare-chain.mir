# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: stack_spill_compare_chain
# CHECK:       MOV32mr $d1, $sp, 36
# CHECK:       bb.1:
# CHECK:       liveins: $d1
# CHECK:       CMP32ri $d1, 2
# CHECK-NEXT:  JCC %bb.{{[0-9]+}}, 2, implicit $flags
# CHECK:       bb.2:
# CHECK:       liveins: $d1
# CHECK:       CMP32ri $d1, 3
# CHECK-NEXT:  JCC %bb.{{[0-9]+}}, 2, implicit $flags
# CHECK-NOT:   CMP32mi 2, $sp, 36
# CHECK-NOT:   CMP32mi 3, $sp, 36

# CHECK-LABEL: name: stack_spill_compare_chain_reject_single
# CHECK:       CMP32mi 2, $sp, 36
# CHECK-NOT:   CMP32ri $d1, 2

--- |
  target triple = "bedrock"

  define void @stack_spill_compare_chain() #0 {
    ret void
  }

  define void @stack_spill_compare_chain_reject_single() #0 {
    ret void
  }

  attributes #0 = { noinline nounwind optnone }
...
---
name: stack_spill_compare_chain
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.3, %bb.1
    liveins: $d0, $d1

    MOV32mr killed $d1, $sp, 36
    CMP8ri $d0, 1, implicit-def $flags
    JCC %bb.3, 2, implicit $flags

  bb.1:
    successors: %bb.4, %bb.2

    CMP32mi 2, $sp, 36, implicit-def $flags
    JCC %bb.4, 2, implicit $flags

  bb.2:
    successors: %bb.5, %bb.6

    CMP32mi 3, $sp, 36, implicit-def $flags
    JCC %bb.5, 2, implicit $flags

  bb.6:
    RET implicit $sp

  bb.3:
    RET implicit $sp

  bb.4:
    RET implicit $sp

  bb.5:
    RET implicit $sp
...
---
name: stack_spill_compare_chain_reject_single
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $d0, $d1

    MOV32mr killed $d1, $sp, 36
    CMP8ri $d0, 1, implicit-def $flags
    JCC %bb.2, 2, implicit $flags

  bb.1:
    successors: %bb.3, %bb.4

    CMP32mi 2, $sp, 36, implicit-def $flags
    JCC %bb.3, 2, implicit $flags

  bb.4:
    RET implicit $sp

  bb.2:
    RET implicit $sp

  bb.3:
    RET implicit $sp
...

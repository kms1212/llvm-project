# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: byte_zext_load
# CHECK:       $d1 = EXTZL8rm $a0, 4
# CHECK-NOT:   MOV8rm
# CHECK-NOT:   EXTZL8rr

# CHECK-LABEL: name: word_sext_load
# CHECK:       $d2 = EXTSQ16rm $a0, 8
# CHECK-NOT:   MOV16rm
# CHECK-NOT:   EXTSQ16rr

# CHECK-LABEL: name: keep_live_loaded_reg
# CHECK:       $d0 = MOV8rm $a0, 4
# CHECK-NOT:   EXTZL8rm
# CHECK-NEXT:  MOV8mr $d0, $a0, 5

--- |
  target triple = "bedrock"

  define void @byte_zext_load() #0 {
    ret void
  }

  define void @word_sext_load() #0 {
    ret void
  }

  define void @keep_live_loaded_reg() #0 {
    ret void
  }

  attributes #0 = { nounwind minsize optsize }
...
---
name: byte_zext_load
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0
    $d0 = MOV8rm $a0, 4
    $d1 = EXTZL8rr killed $d0, implicit-def dead $flags
    RET implicit $sp
...
---
name: word_sext_load
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0
    $d0 = MOV16rm $a0, 8
    $d2 = EXTSQ16rr killed $d0, implicit-def dead $flags
    RET implicit $sp
...
---
name: keep_live_loaded_reg
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0
    $d0 = MOV8rm $a0, 4
    $d1 = EXTZL8rr $d0, implicit-def dead $flags
    MOV8mr $d0, $a0, 5
    RET implicit $sp
...

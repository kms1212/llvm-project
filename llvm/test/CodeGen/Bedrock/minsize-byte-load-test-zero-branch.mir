# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: byte_load_test_zero_branch
# CHECK:       CMP8mi 0, $a0, 12
# CHECK-NOT:   TEST8rr

# CHECK-LABEL: name: byte_load_test_zero_branch_value_live
# CHECK:       $d1 = MOV8rm $a0, 12
# CHECK:       TEST8rr $d1, $d1

# CHECK-LABEL: name: byte_load_known_zero_cmp_branch
# CHECK:       CMP8mi 0, $a0, 12
# CHECK-NOT:   MOV8rm
# CHECK-NOT:   CMP8rr

--- |
  target triple = "bedrock"

  define void @byte_load_test_zero_branch() #0 {
    ret void
  }

  define void @byte_load_test_zero_branch_value_live() #0 {
    ret void
  }

  define void @byte_load_known_zero_cmp_branch() #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: byte_load_test_zero_branch
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0
    successors: %bb.1, %bb.2

    $d1 = MOV8rm $a0, 12
    TEST8rr $d1, $d1, implicit-def $flags
    JCC %bb.1, 2, implicit $flags
    JMP %bb.2

  bb.1:
    RET implicit $sp

  bb.2:
    RET implicit $sp
...
---
name: byte_load_test_zero_branch_value_live
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0
    successors: %bb.1, %bb.2

    $d1 = MOV8rm $a0, 12
    TEST8rr $d1, $d1, implicit-def $flags
    JCC %bb.1, 2, implicit $flags
    JMP %bb.2

  bb.1:
    RET implicit $sp

  bb.2:
    liveins: $d1

    $d0 = MOV8rr $d1
    RET implicit $sp
...
---
name: byte_load_known_zero_cmp_branch
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0
    successors: %bb.1, %bb.2

    $d4 = CLR64r
    $d1 = MOV8rm $a0, 12
    CMP8rr $d1, $d4, implicit-def $flags
    JCC %bb.1, 2, implicit $flags
    JMP %bb.2

  bb.1:
    RET implicit $sp

  bb.2:
    RET implicit $sp
...

# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: dimm_copy_to_aimm
# CHECK-NOT:   $d0 = MOV32ri 32768
# CHECK-NOT:   MOV64rr
# CHECK:       MOV8absmr $d1, 32768
# CHECK-NEXT:  MOV8absmr $d2, 32768
# CHECK-NOT:   MOV64rr

--- |
  target triple = "bedrock"

  define void @dimm_copy_to_aimm() #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: dimm_copy_to_aimm
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d1, $d2

    $d0 = MOV32ri 32768
    $a0 = MOV64rr $d0
    $a1 = MOV64rr killed $d0
    MOV8mr $d1, $a0, 0
    MOV8mr $d2, killed $a1, 0
    RET implicit $sp
...

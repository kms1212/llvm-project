# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: borrowed_stack_address_base
# CHECK:       frame-setup PUSHM 49152
# CHECK:       $sp = frame-setup SUB64ri $sp, 56
# CHECK-NEXT:  $a7 = LEAri $sp, 416
# CHECK-NOT:   LEAri $sp, 416
# CHECK:       $a0 = MOV64rr $a7
# CHECK:       CALLpcrel16 @sink0
# CHECK:       $a1 = MOV64rr $a7
# CHECK:       CALLpcrel16 @sink1
# CHECK:       $a2 = MOV64rr $a7
# CHECK:       CALLpcrel16 @sink2
# CHECK:       $a0 = MOV64rr $a7
# CHECK:       CALLpcrel16 @sink3
# CHECK:       frame-destroy POPM 49152

--- |
  target triple = "bedrock"

  declare void @sink0(ptr)
  declare void @sink1(ptr)
  declare void @sink2(ptr)
  declare void @sink3(ptr)

  define void @borrowed_stack_address_base() #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: borrowed_stack_address_base
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a6

    frame-setup PUSHM 16384, implicit-def $sp, implicit $sp, implicit killed $a6
    $sp = frame-setup SUB64ri $sp, 56
    $a6 = LEAri $sp, 8
    MOV64mr $a6, $sp, 0
    $a0 = LEAri $sp, 416
    CALLpcrel16 @sink0, csr_bedrock, implicit-def $sp, implicit $sp, implicit $a0
    $a1 = LEAri $sp, 416
    CALLpcrel16 @sink1, csr_bedrock, implicit-def $sp, implicit $sp, implicit $a1
    $a2 = LEAri $sp, 416
    CALLpcrel16 @sink2, csr_bedrock, implicit-def $sp, implicit $sp, implicit $a2
    $a0 = LEAri $sp, 416
    CALLpcrel16 @sink3, csr_bedrock, implicit-def $sp, implicit $sp, implicit $a0
    $sp = frame-destroy ADD64ri $sp, 56
    frame-destroy POPM 16384, implicit-def $sp, implicit $sp, implicit-def $a6
    RET implicit $sp
...

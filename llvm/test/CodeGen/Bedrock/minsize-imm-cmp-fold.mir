# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: imm_cmp_fold
# CHECK:       $d1 = MOV8ri 7
# CHECK-NEXT:  CMP8ri $d1, 80
# CHECK-NEXT:  $d1 = MOV32ri 7
# CHECK-NEXT:  CMP32ri $d1, 63
# CHECK-NEXT:  $d1 = MOV32ri 7
# CHECK-NEXT:  CMP32ri $d1, 64

--- |
  target triple = "bedrock"

  define void @imm_cmp_fold() #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: imm_cmp_fold
tracksRegLiveness: true
body: |
  bb.0:
    $d1 = MOV8ri 7
    $d2 = MOV8ri 80
    CMP8rr killed $d1, killed $d2, implicit-def $flags
    $d1 = MOV32ri 7
    $d2 = MOV32ri 63
    CMP32rr killed $d1, killed $d2, implicit-def $flags
    $d1 = MOV32ri 7
    $d2 = MOV32ri 64
    CMP32rr killed $d1, killed $d2, implicit-def $flags
    RET implicit $sp
...

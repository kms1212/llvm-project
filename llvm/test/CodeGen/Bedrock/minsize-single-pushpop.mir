# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: single_pushpop
# CHECK:       frame-setup PUSHA killed $a6
# CHECK-NOT:   MOV64mr {{.*}}$sp, 16
# CHECK:       $a6 = frame-destroy POPA
# CHECK-NOT:   MOV64rm $sp, 16

--- |
  target triple = "bedrock"

  define void @single_pushpop() #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: single_pushpop
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0, $a6, $d0

    $sp = frame-setup SUB64ri $sp, 24, implicit-def $flags
    MOV64mr killed $a6, $sp, 16
    $a6 = MOV64rr $a0
    MOV32mr $d0, $a0, 0
    $a6 = MOV64rm $sp, 16
    $sp = frame-destroy ADD64ri $sp, 24, implicit-def $flags
    RET implicit $sp
...

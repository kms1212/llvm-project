# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: a6_base_stack_spill
# CHECK:       $sp = frame-setup SUB64ri $sp, 16
# CHECK-NEXT:  MOV64mr $a6, $sp, 8
# CHECK-NEXT:  $a6 = MOV64rr $a0
# CHECK:       CALLpcrel16 @callee
# CHECK-NEXT:  MOV32mr $d0, $a6, 8
# CHECK-NOT:   $a6 = MOV64rm $sp, 8
# CHECK:       $sp = frame-destroy ADD64ri $sp, 16

--- |
  target triple = "bedrock"

  declare i32 @callee(i32)

  define void @a6_base_stack_spill() #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: a6_base_stack_spill
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0, $a6, $d0

    $sp = frame-setup SUB64ri $sp, 24, implicit-def $flags
    MOV64mr $a6, $sp, 8
    $a6 = MOV64rr $a0
    $d1 = MOV32rm $a6, 4
    CALLpcrel16 @callee, csr_bedrock, implicit-def $sp, implicit $sp, implicit $d0, implicit-def $d0
    MOV32mr $d0, $a6, 8
    $a6 = MOV64rm $sp, 8
    $sp = frame-destroy ADD64ri $sp, 24, implicit-def $flags
    RET implicit $sp
...

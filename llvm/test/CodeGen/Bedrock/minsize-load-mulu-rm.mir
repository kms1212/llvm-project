# RUN: llc -mtriple=bedrock -start-before=bedrock-push-pop-merge -stop-after=bedrock-push-pop-merge -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: load_mulu_rm
# CHECK-NOT:   MOV32rm $sp, 16
# CHECK:       $d2 = MULU32rm $d2, $sp, 16

# CHECK-LABEL: name: stack_const_mulu_rm
# CHECK-NOT:   MOV32mr
# CHECK-NOT:   MULU32rm
# CHECK:       $d2 = MULU32ri $d2, 97

# CHECK-LABEL: name: load_madd_product_acc
# CHECK:       $d5 = MOV32rr $d0
# CHECK-NEXT:  $d5 = MADD32mrr $d5, $a0, 0, $d1
# CHECK-NOT:   MULU32rr
# CHECK-NOT:   ADD32rr

# CHECK-LABEL: name: load_madd_loaded_acc
# CHECK:       $d6 = MOV32rm $a0, 4
# CHECK-NEXT:  $d6 = MADD32mrr $d6, $a0, 0, $d0
# CHECK-NOT:   MULU32rr
# CHECK-NOT:   ADD32rr

# CHECK-LABEL: name: load_mulu_after_imm
# CHECK:       $d2 = MOV32ri 13
# CHECK-NEXT:  $d2 = MULU32rm $d2, $a0, 0
# CHECK-NOT:   MOV32rm $a0, 0
# CHECK-NOT:   MULU32rr

--- |
  target triple = "bedrock"

  define void @load_mulu_rm() #0 {
    ret void
  }

  define void @stack_const_mulu_rm() #0 {
    ret void
  }

  define void @load_madd_product_acc() #0 {
    ret void
  }

  define void @load_madd_loaded_acc() #0 {
    ret void
  }

  define void @load_mulu_after_imm() #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: load_mulu_rm
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d2

    $d0 = MOV32rm $sp, 16
    $d2 = MULU32rr $d2, killed $d0
    RET implicit $sp
...
---
name: stack_const_mulu_rm
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d2

    $d1 = MOV32ri 97
    MOV32mr killed $d1, $sp, 8
    $d2 = MULU32rm $d2, $sp, 8
    RET implicit $sp
...
---
name: load_madd_product_acc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0, $d0, $d1, $sp

    $d5 = MOV32rm $a0, 0
    $d5 = MULU32rr killed $d5, $d1
    $d5 = ADD32rr $d5, $d0
    RET implicit $sp, implicit $d5
...
---
name: load_madd_loaded_acc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0, $d0, $sp

    $d1 = MOV32rm $a0, 0
    $d1 = MULU32rr killed $d1, $d0
    $d6 = MOV32rm $a0, 4
    $d6 = ADD32rr $d6, killed $d1
    RET implicit $sp, implicit $d6
...
---
name: load_mulu_after_imm
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0, $sp

    $d0 = MOV32rm $a0, 0
    $d2 = MOV32ri 13
    $d2 = MULU32rr $d2, killed $d0
    RET implicit $sp, implicit $d2
...

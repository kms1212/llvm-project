# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: strided_imm_qword_stores
# CHECK:       $d0 = MOV32ri 1000
# CHECK-NEXT:  $a0 = MOV64rr $d0
# CHECK-NEXT:  $d0 = MOV64ri 20000
# CHECK-NEXT:  MOV64mr $d0, $a0, 0
# CHECK:       $a0 = ADD64ri $a0, 8, implicit-def $flags
# CHECK-NEXT:  $d0 = ADD64ri $d0, 4096, implicit-def $flags
# CHECK-NEXT:  MOV64mr $d0, $a0, 0
# CHECK:       $a0 = ADD64ri $a0, 8, implicit-def $flags
# CHECK-NEXT:  $d0 = ADD64ri $d0, 4096, implicit-def $flags
# CHECK-NEXT:  MOV64mr killed $d0, killed $a0, 0
# CHECK-NOT:   MOV32ri 1008
# CHECK-NOT:   MOV64ri 24096

# CHECK-LABEL: name: strided_imm_qword_stores_flags_live
# CHECK:       CMP32ri $d2, 1
# CHECK:       $d0 = MOV32ri 1008
# CHECK:       $d0 = MOV64ri 24096
# CHECK-NOT:   ADD64ri $a0, 8
# CHECK-NOT:   ADD64ri $d0, 4096

--- |
  target triple = "bedrock"

  define void @strided_imm_qword_stores() #0 {
    ret void
  }

  define void @strided_imm_qword_stores_flags_live() #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: strided_imm_qword_stores
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d1, $a1

    $d0 = MOV32ri 1000
    $a0 = MOV64rr $d0
    $d0 = MOV64ri 20000
    MOV64mr killed $d0, killed $a0, 0
    MOV64mr $d1, $a1, 0
    $d0 = MOV32ri 1008
    $a0 = MOV64rr $d0
    $d0 = MOV64ri 24096
    MOV64mr killed $d0, killed $a0, 0
    MOV64mr $d1, $a1, 0
    $d0 = MOV32ri 1016
    $a0 = MOV64rr $d0
    $d0 = MOV64ri 28192
    MOV64mr killed $d0, killed $a0, 0
    RET implicit $sp
...
---
name: strided_imm_qword_stores_flags_live
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $d1, $d2, $a1

    CMP32ri $d2, 1, implicit-def $flags
    $d0 = MOV32ri 1000
    $a0 = MOV64rr $d0
    $d0 = MOV64ri 20000
    MOV64mr killed $d0, killed $a0, 0
    MOV64mr $d1, $a1, 0
    $d0 = MOV32ri 1008
    $a0 = MOV64rr $d0
    $d0 = MOV64ri 24096
    MOV64mr killed $d0, killed $a0, 0
    MOV64mr $d1, $a1, 0
    $d0 = MOV32ri 1016
    $a0 = MOV64rr $d0
    $d0 = MOV64ri 28192
    MOV64mr killed $d0, killed $a0, 0
    JCC %bb.1, 2, implicit $flags

  bb.2:
    RET implicit $sp

  bb.1:
    RET implicit $sp
...

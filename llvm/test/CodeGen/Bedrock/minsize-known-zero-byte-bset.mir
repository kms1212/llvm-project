# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: known_zero_byte_store
# CHECK:       CMP8mi 0, $a0, 12
# CHECK:       JCC %bb.{{[0-9]+}}, 2
# CHECK:       BSET8mi 0, $a0, 12
# CHECK-NOT:   MOV8mi 1, $a0, 12

# CHECK-LABEL: name: multi_pred_byte_store
# CHECK:       MOV8mi 1, $a0, 12
# CHECK-NOT:   BSET8mi 0, $a0, 12

--- |
  target triple = "bedrock"

  define void @known_zero_byte_store() #0 {
    ret void
  }

  define void @multi_pred_byte_store() #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: known_zero_byte_store
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $a0

    CMP8mi 0, $a0, 12, implicit-def $flags
    JCC %bb.1, 2, implicit $flags

  bb.2:
    RET implicit $sp

  bb.1:
    liveins: $a0, $d0, $d1, $d2

    MOV32mr killed $d0, $a0, 8
    MOV32mm $sp, 20, $a0, 4
    MOV32mr killed $d2, $a0, 0
    MOV8mi 1, $a0, 12
    RET implicit $sp
...
---
name: multi_pred_byte_store
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $a0

    CMP8mi 0, $a0, 12, implicit-def $flags
    JCC %bb.1, 2, implicit $flags

  bb.2:
    successors: %bb.1
    liveins: $a0

    JMP %bb.1

  bb.1:
    liveins: $a0

    MOV8mi 1, $a0, 12
    RET implicit $sp
...

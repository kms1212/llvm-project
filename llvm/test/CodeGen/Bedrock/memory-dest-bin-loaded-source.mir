# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: add_loaded_source_to_loaded_dest
# CHECK:       $d0 = MOV32rm $a1, 0
# CHECK-NEXT:  ADD32mr $d0, $a0, 0
# CHECK-NOT:   MOV32rm $a0, 0
# CHECK-NOT:   MOV32mr

# CHECK-LABEL: name: mulu_loaded_source_to_loaded_dest
# CHECK:       $d0 = MOV32rm $a1, 0
# CHECK-NEXT:  MULU32mr $d0, $a0, 0
# CHECK-NOT:   MOV32rm $a0, 0
# CHECK-NOT:   MOV32mr

# CHECK-LABEL: name: add_two_loaded_sources_to_loaded_dest
# CHECK:       $d0 = MOV32rm $a1, 0
# CHECK-NEXT:  $d1 = MOV32rm $a7, 0
# CHECK-NEXT:  $d1 = ADD32rr $d1, killed $d0
# CHECK-NEXT:  ADD32mr killed $d1, $a0, 0
# CHECK-NOT:   MOV32rm $a0, 0
# CHECK-NOT:   MOV32mr

# CHECK-LABEL: name: xor_two_loaded_sources_to_loaded_dest
# CHECK:       $d0 = MOV32rm $a1, 0
# CHECK-NEXT:  $d1 = MOV32rm $a7, 0
# CHECK-NEXT:  $d1 = XOR32rr $d1, killed $d0
# CHECK-NEXT:  XOR32mr killed $d1, $a0, 0
# CHECK-NOT:   MOV32rm $a0, 0
# CHECK-NOT:   MOV32mr

--- |
  target triple = "bedrock"

  define void @add_loaded_source_to_loaded_dest() #0 {
    ret void
  }

  define void @mulu_loaded_source_to_loaded_dest() #0 {
    ret void
  }

  define void @add_two_loaded_sources_to_loaded_dest() #0 {
    ret void
  }

  define void @xor_two_loaded_sources_to_loaded_dest() #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: add_loaded_source_to_loaded_dest
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0, $a1

    $d0 = MOV32rm $a1, 0 :: (load (s32))
    $d1 = MOV32rm $a0, 0 :: (load (s32))
    $d1 = ADD32rr $d1, killed $d0, implicit-def dead $flags
    MOV32mr killed $d1, $a0, 0 :: (store (s32))
    RET implicit $sp
...
---
name: mulu_loaded_source_to_loaded_dest
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0, $a1

    $d0 = MOV32rm $a1, 0 :: (load (s32))
    $d1 = MOV32rm $a0, 0 :: (load (s32))
    $d1 = MULU32rr $d1, killed $d0, implicit-def dead $flags
    MOV32mr killed $d1, $a0, 0 :: (store (s32))
    RET implicit $sp
...
---
name: add_two_loaded_sources_to_loaded_dest
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0, $a1, $a7

    $d0 = MOV32rm $a1, 0 :: (load (s32))
    $d1 = MOV32rm $a0, 0 :: (load (s32))
    $d1 = ADD32rr $d1, killed $d0, implicit-def dead $flags
    $d0 = MOV32rm $a7, 0 :: (load (s32))
    $d0 = ADD32rr killed $d0, killed $d1, implicit-def dead $flags
    MOV32mr killed $d0, $a0, 0 :: (store (s32))
    RET implicit $sp
...
---
name: xor_two_loaded_sources_to_loaded_dest
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0, $a1, $a7

    $d0 = MOV32rm $a1, 0 :: (load (s32))
    $d1 = MOV32rm $a0, 0 :: (load (s32))
    $d1 = XOR32rr $d1, killed $d0, implicit-def dead $flags
    $d0 = MOV32rm $a7, 0 :: (load (s32))
    $d0 = XOR32rr killed $d0, killed $d1, implicit-def dead $flags
    MOV32mr killed $d0, $a0, 0 :: (store (s32))
    RET implicit $sp
...

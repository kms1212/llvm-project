# RUN: llc -mtriple=bedrock -start-before=bedrock-push-pop-merge -stop-after=bedrock-push-pop-merge -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: wide_zero_fill_djt
# CHECK-NOT:   MOV64mr
# CHECK-NOT:   DJCC32r
# CHECK:       $d2 = MOV32ri 256
# CHECK-NEXT:  $d2 = REPMOV32postmr $d2, $d0, $a1, 4

--- |
  target triple = "bedrock"

  define void @wide_zero_fill_djt(ptr %p) #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: wide_zero_fill_djt
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $a0

    $d0 = CLR64r
    $a1 = MOV64rr $a0
    $d2 = MOV32ri 64
    JMP %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $a1, $d0, $d2

    MOV64mr $d0, $a1, 8
    MOV64mr $d0, $a1, 0
    $a1 = ADD64ri $a1, 16, implicit-def dead $flags
    $d2 = DJCC32r $d2, %bb.1, 0

  bb.2:
    RET implicit $sp
...

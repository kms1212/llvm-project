# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: areg_copy_coalescing
# CHECK-NOT:   $a5 = MOV64rr $a4
# CHECK:       $a4 = SHL64ri $a4, 1, implicit-def dead $flags
# CHECK-NEXT:  $d0 = MOV8rm $a4, 0

--- |
  target triple = "bedrock"

  define i32 @areg_copy_coalescing() #0 {
    ret i32 0
  }

  attributes #0 = { minsize optsize }
...
---
name: areg_copy_coalescing
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a4

    $a5 = MOV64rr $a4
    $a5 = SHL64ri killed $a5, 1, implicit-def dead $flags
    $d0 = MOV8rm killed $a5, 0
    RET implicit $sp, implicit $d0
...

# RUN: llc -mtriple=bedrock -start-after=prologepilog -verify-machineinstrs %s -o - | FileCheck %s

# REQUIRES: bedrock-registered-target

--- |
  target triple = "bedrock"

  define void @drop_dec_test_eq() {
    ret void
  }

  define void @drop_and_test_eq() {
    ret void
  }

  define void @fold_mov_and_test_eq_to_btest() {
    ret void
  }

  define void @fold_zero_copy_chain_to_clr() {
    ret void
  }

  define void @fold_offset_load_store_to_mem_move() {
    ret void
  }

  define void @keep_dec_test_lt() {
    ret void
  }

  define void @keep_and_test_lt() {
    ret void
  }

  define void @drop_dec_test_eq_minsize() minsize {
    ret void
  }
...
---
name:            drop_dec_test_eq
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: drop_dec_test_eq:
    ; CHECK: dec.q r1
    ; CHECK-NEXT: testjeq.q r1, r1,
    $r1 = DECQ3r killed $r1
    TESTQrr $r1, $r1, implicit-def $flags
    BRCC %bb.1, 2, implicit $flags
    RET

  bb.1:
    RET
...
name:            drop_and_test_eq
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: drop_and_test_eq:
    ; CHECK: and.q 1, r1
    ; CHECK-NEXT: testjeq.q r1, r1,
    $r1 = ANDQ3ri killed $r1, 1
    TESTQrr $r1, $r1, implicit-def $flags
    BRCC %bb.1, 2, implicit $flags
    RET

  bb.1:
    RET
...
---
name:            fold_mov_and_test_eq_to_btest
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: fold_mov_and_test_eq_to_btest:
    ; CHECK-NOT: mov.q r1, r0
    ; CHECK-NOT: and.q 1, r0
    ; CHECK: btest 0, r1
    ; CHECK-NEXT: jeq
    ; CHECK-NOT: test.q r0, r0
    $r0 = MOVQrr killed $r1
    $r0 = ANDQ3ri killed $r0, 1
    TESTQrr $r0, $r0, implicit-def $flags
    BRCC %bb.1, 2, implicit $flags
    RET

  bb.1:
    RET
...
---
name:            fold_zero_copy_chain_to_clr
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: fold_zero_copy_chain_to_clr:
    ; CHECK: clr.q r8
    ; CHECK-NEXT: clr.q r9
    ; CHECK-NEXT: clr.q r10
    ; CHECK-NOT: mov.q r8, r9
    ; CHECK-NOT: mov.q r8, r10
    $r8 = CONST64 0
    $r9 = MOVQrr $r8
    $r10 = MOVQrr killed $r8
    RET
...
---
name:            fold_offset_load_store_to_mem_move
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r8, $r10
    ; CHECK-LABEL: fold_offset_load_store_to_mem_move:
    ; CHECK-NOT: mov.q [r8 + 152], r0
    ; CHECK: mov.q [r8 + 152], [r10 + 24]
    ; CHECK-NOT: mov.q r0, [r10 + 24]
    $r0 = LOADQro $r8, 152
    STOREQro killed $r0, $r10, 24
    RET
...
name:            keep_dec_test_lt
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: keep_dec_test_lt:
    ; CHECK: dec.q r1
    ; CHECK-NEXT: testjlt.q r1, r1,
    $r1 = DECQ3r killed $r1
    TESTQrr $r1, $r1, implicit-def $flags
    BRCC %bb.1, 12, implicit $flags
    RET

  bb.1:
    RET
...
---
name:            keep_and_test_lt
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: keep_and_test_lt:
    ; CHECK: and.q 1, r1
    ; CHECK-NEXT: testjlt.q r1, r1,
    $r1 = ANDQ3ri killed $r1, 1
    TESTQrr $r1, $r1, implicit-def $flags
    BRCC %bb.1, 12, implicit $flags
    RET

  bb.1:
    RET
...
---
name:            drop_dec_test_eq_minsize
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: drop_dec_test_eq_minsize:
    ; CHECK: dec.q r1
    ; CHECK-NEXT: test.q r1, r1
    ; CHECK-NEXT: jeq
    $r1 = DECQ3r killed $r1
    TESTQrr $r1, $r1, implicit-def $flags
    BRCC %bb.1, 2, implicit $flags
    RET

  bb.1:
    RET
...

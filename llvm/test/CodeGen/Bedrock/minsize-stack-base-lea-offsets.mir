# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: stack_base_fold
# CHECK-NOT:   $a7 = LEAri $sp, 184
# CHECK:       $a0 = LEAri $sp, 208
# CHECK-NEXT:  $a1 = LEAri $sp, 1960
# CHECK-NEXT:  $a0 = LEAri $sp, 3100
# CHECK-NOT:   ADD64ri
# CHECK-NOT:   MOV64rr
# CHECK-LABEL: name: stack_address_reuse
# CHECK:       $a0 = LEAri $sp, 416
# CHECK-NEXT:  RET implicit $sp
# CHECK-NOT:   $a6 = LEAri $sp, 416
# CHECK-NOT:   $a0 = MOV64rr $a6

--- |
  target triple = "bedrock"

  define void @stack_base_fold() #0 {
    ret void
  }

  define void @stack_address_reuse() #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: stack_base_fold
tracksRegLiveness: true
body: |
  bb.0:
    $a7 = LEAri $sp, 184
    $a0 = LEAri $a7, 24
    $d0 = MOV32ri 16
    $a1 = LEAri $a7, 1776
    $a7 = ADD64ri $a7, 2916, implicit-def $flags
    $a0 = MOV64rr killed $a7
    RET implicit $sp
...
---
name: stack_address_reuse
tracksRegLiveness: true
body: |
  bb.0:
    $a6 = LEAri $sp, 416
    $d0 = MOV32ri 1
    $a0 = LEAri $sp, 416
    RET implicit $sp
...

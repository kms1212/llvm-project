# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: sp_add_to_lea_across_successor
# CHECK:       $a0 = LEAri $sp, 104
# CHECK-NOT:   ADD64ri

# CHECK-LABEL: name: sp_add_to_lea_flags_live_negative
# CHECK:       $a0 = MOV64rr $sp
# CHECK-NEXT:  $a0 = ADD64ri killed $a0, 104
# CHECK-NEXT:  JCC %bb.{{[0-9]+}}, 2, implicit $flags

--- |
  target triple = "bedrock"

  define void @sp_add_to_lea_across_successor() {
    ret void
  }

  define void @sp_add_to_lea_flags_live_negative() {
    ret void
  }
...
---
name: sp_add_to_lea_across_successor
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1

    $a0 = MOV64rr $sp
    $a0 = ADD64ri killed $a0, 104, implicit-def $flags
    JMP %bb.1

  bb.1:
    liveins: $a0

    CMP64ri $a0, 0, implicit-def $flags
    RET implicit $sp
...
---
name: sp_add_to_lea_flags_live_negative
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2

    $a0 = MOV64rr $sp
    $a0 = ADD64ri killed $a0, 104, implicit-def $flags
    JCC %bb.1, 2, implicit $flags

  bb.2:
    RET implicit $sp

  bb.1:
    liveins: $a0

    RET implicit $sp
...

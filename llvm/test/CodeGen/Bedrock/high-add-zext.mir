# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: high_add_zext
# CHECK-NOT:   ADD64ri
# CHECK:       $d6 = EXTZQ32rr killed $d6

# CHECK-LABEL: name: high_add_zext_areg
# CHECK-NOT:   ADD64ri
# CHECK:       $a0 = EXTZQ32rr killed $a0

# CHECK-LABEL: name: low_add_zext_negative
# CHECK:       $d6 = ADD64ri killed $d6, 4294967297
# CHECK:       $d6 = EXTZQ32rr killed $d6

--- |
  target triple = "bedrock"

  define void @high_add_zext() {
    ret void
  }

  define void @high_add_zext_areg() {
    ret void
  }

  define void @low_add_zext_negative() {
    ret void
  }
...
---
name: high_add_zext
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d6

    $d6 = ADD64ri killed $d6, 4294967296, implicit-def dead $flags
    $d6 = EXTZQ32rr killed $d6, implicit-def $flags
    RET implicit $sp
...
---
name: high_add_zext_areg
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0

    $a0 = ADD64ri killed $a0, 4294967296, implicit-def dead $flags
    $a0 = EXTZQ32rr killed $a0, implicit-def $flags
    RET implicit $sp
...
---
name: low_add_zext_negative
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d6

    $d6 = ADD64ri killed $d6, 4294967297, implicit-def dead $flags
    $d6 = EXTZQ32rr killed $d6, implicit-def $flags
    RET implicit $sp
...

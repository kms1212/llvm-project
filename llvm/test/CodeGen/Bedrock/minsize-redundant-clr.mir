# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: redundant_clr_dead_flags
# CHECK:       $d0 = CLR64r
# CHECK-NEXT:  MOV32mr $d0, $a0, 32
# CHECK-NEXT:  CLRm $a0, 8
# CHECK-NOT:   $d0 = CLR64r

# CHECK-LABEL: name: redundant_clr_live_flags
# CHECK:       $d0 = CLR64r
# CHECK:       $d0 = CLR64r
# CHECK-NEXT:  JCC %bb.{{[0-9]+}}, 2, implicit $flags

# CHECK-LABEL: name: redundant_mov_zero_store_callee_saved
# CHECK:       frame-setup PUSHA killed $a6
# CHECK-NEXT:  $a6 = MOV64rr $a0
# CHECK-NEXT:  CLRm $a6, 192
# CHECK-NOT:   $a7 = MOV64ri 0
# CHECK:       CALLpcrel16 @redundant_clr_dead_flags
# CHECK:       $a6 = frame-destroy POPA

--- |
  target triple = "bedrock"

  define void @redundant_clr_dead_flags() #0 {
    ret void
  }

  define void @redundant_clr_live_flags() #0 {
    ret void
  }

  define void @redundant_mov_zero_store_callee_saved() #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: redundant_clr_dead_flags
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0

    $d0 = CLR64r
    MOV32mr $d0, $a0, 32
    $d0 = CLR64r
    MOV64mr $d0, $a0, 8
    RET implicit $sp
...
---
name: redundant_clr_live_flags
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0
    successors: %bb.1, %bb.2

    $d0 = CLR64r
    MOV32mr $d0, $a0, 32
    $d0 = CLR64r
    JCC %bb.1, 2, implicit $flags

  bb.2:
    RET implicit $sp

  bb.1:
    RET implicit $sp
...
---
name: redundant_mov_zero_store_callee_saved
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $a0, $a6, $a7

    frame-setup PUSHM 49152, implicit-def $sp, implicit $sp, implicit killed $a6, implicit killed $a7
    $a6 = MOV64rr $a0
    $a7 = MOV64ri 0
    MOV64mr $a7, $a6, 192
    CALLpcrel16 @redundant_clr_dead_flags, csr_bedrock, implicit-def $sp, implicit $sp, implicit-def $d0
    MOV32mr killed $d0, $a6, 200
    JMP %bb.1

  bb.1:
    liveins: $a6, $a7

    frame-destroy POPM 49152, implicit-def $sp, implicit $sp, implicit-def $a6, implicit-def $a7
    RET implicit $sp
...

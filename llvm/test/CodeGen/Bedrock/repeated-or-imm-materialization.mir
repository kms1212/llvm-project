# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: repeated_or_imm_materialization
# CHECK:       $d1 = MOV64ri 60129542144
# CHECK:       $d0 = MOV64rr $d1
# CHECK-NEXT:  $d0 = OR32imm $d0, @a
# CHECK:       $d0 = MOV64rr $d1
# CHECK-NEXT:  $d0 = OR32imm $d0, @b
# CHECK:       $d0 = MOV64rr $d1
# CHECK-NEXT:  $d0 = OR32imm $d0, @c
# CHECK-NOT:   OR64ri $d0, 60129542144

# CHECK-LABEL: name: keep_short_or_imm_runs
# CHECK:       $d0 = MOV64ri 60129542144
# CHECK-NEXT:  $d0 = OR32imm $d0, @a
# CHECK:       $d0 = MOV64ri 60129542144
# CHECK-NEXT:  $d0 = OR32imm $d0, @b
# CHECK-NOT:   OR64rr

# CHECK-LABEL: name: repeated_or_imm_materialization_with_successor
# CHECK:       $d1 = MOV64ri 60129542144
# CHECK:       $d0 = MOV64rr $d1
# CHECK-NEXT:  $d0 = OR32imm $d0, @a
# CHECK:       $d0 = MOV64rr $d1
# CHECK-NEXT:  $d0 = OR32imm $d0, @b
# CHECK:       $d0 = MOV64rr $d1
# CHECK-NEXT:  $d0 = OR32imm $d0, @c
# CHECK-NOT:   OR64ri $d0, 60129542144

--- |
  target triple = "bedrock"

  @a = external global i8
  @b = external global i8
  @c = external global i8

  define void @repeated_or_imm_materialization() #0 {
    ret void
  }

  define void @keep_short_or_imm_runs() #0 {
    ret void
  }

  define void @repeated_or_imm_materialization_with_successor() #0 {
    ret void
  }

  attributes #0 = { nounwind minsize optsize }
...
---
name: repeated_or_imm_materialization
tracksRegLiveness: true
body: |
  bb.0:
    $d0 = MOV32imm @a
    $d0 = EXTZQ32rr $d0, implicit-def dead $flags
    $d0 = OR64ri $d0, 60129542144, implicit-def dead $flags
    MOV64mr killed $d0, $sp, 0
    $d0 = MOV32imm @b
    $d0 = EXTZQ32rr $d0, implicit-def dead $flags
    $d0 = OR64ri $d0, 60129542144, implicit-def dead $flags
    MOV64mr killed $d0, $sp, 8
    $d0 = MOV32imm @c
    $d0 = EXTZQ32rr $d0, implicit-def dead $flags
    $d0 = OR64ri $d0, 60129542144, implicit-def dead $flags
    MOV64mr killed $d0, $sp, 16
    RET implicit $sp
...
---
name: keep_short_or_imm_runs
tracksRegLiveness: true
body: |
  bb.0:
    $d0 = MOV32imm @a
    $d0 = EXTZQ32rr $d0, implicit-def dead $flags
    $d0 = OR64ri $d0, 60129542144, implicit-def dead $flags
    MOV64mr killed $d0, $sp, 0
    $d0 = MOV32imm @b
    $d0 = EXTZQ32rr $d0, implicit-def dead $flags
    $d0 = OR64ri $d0, 60129542144, implicit-def dead $flags
    MOV64mr killed $d0, $sp, 8
    RET implicit $sp
...
---
name: repeated_or_imm_materialization_with_successor
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    $d0 = MOV32imm @a
    $d0 = EXTZQ32rr $d0, implicit-def dead $flags
    $d0 = OR64ri $d0, 60129542144, implicit-def dead $flags
    MOV64mr killed $d0, $sp, 0
    $d0 = MOV32imm @b
    $d0 = EXTZQ32rr $d0, implicit-def dead $flags
    $d0 = OR64ri $d0, 60129542144, implicit-def dead $flags
    MOV64mr killed $d0, $sp, 8
    $d0 = MOV32imm @c
    $d0 = EXTZQ32rr $d0, implicit-def dead $flags
    $d0 = OR64ri $d0, 60129542144, implicit-def dead $flags
    MOV64mr killed $d0, $sp, 16
    JMP %bb.1

  bb.1:
    RET implicit $sp
...

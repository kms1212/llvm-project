# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -filetype=obj %s -o /dev/null

# CHECK-LABEL: name: fallthrough_ret_keeps_conditional_successor
# CHECK: bb.0:
# CHECK: successors: %bb.1
# CHECK: TEST32rr $d0, $d0
# CHECK-NEXT: JCC %bb.1, 3
# CHECK-NEXT: RET

--- |
  target triple = "bedrock"

  define void @fallthrough_ret_keeps_conditional_successor() #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: fallthrough_ret_keeps_conditional_successor
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $d0

    TEST32rr $d0, $d0, implicit-def $flags
    JCC %bb.1, 3, implicit $flags
    JMP %bb.2

  bb.1:
    liveins: $d0

    $d1 = MOV32rr $d0
    RET implicit $sp, implicit $d1

  bb.2:
    RET implicit $sp
...

# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: imm16_store_fold
# CHECK-NOT:   MOV16mr
# CHECK:       MOV16mi 20564, $a6, 0
# CHECK:       MOV16mi 1234, $sp, 8

--- |
  target triple = "bedrock"

  define void @imm16_store_fold() #0 {
    ret void
  }

  attributes #0 = { minsize optsize }
...
---
name: imm16_store_fold
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a6

    $d0 = MOV16ri 20564
    MOV16mr killed $d0, $a6, 0
    $d1 = MOV16ri 1234
    MOV16mr killed $d1, $sp, 8
    RET implicit $sp
...

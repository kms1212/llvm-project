# RUN: llc -mtriple=bedrock -start-before=bedrock-peephole -stop-after=bedrock-peephole -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: o0_clr_zero_cmp_jcc
# CHECK-NOT:   CLR64r
# CHECK-NOT:   CMP32rr
# CHECK:       TEST32rr $d0, $d0
# CHECK-NEXT:  JCC %bb.{{[0-9]+}}, 2

# CHECK-LABEL: name: o0_live_zero_negative
# CHECK:       $d1 = CLR64r
# CHECK-NEXT:  CMP32rr $d1, $d0
# CHECK-NEXT:  JCC %bb.{{[0-9]+}}, 2

# CHECK-LABEL: name: a_reg_zero_cmp_imm
# CHECK-NOT:   CLR64r
# CHECK:       CMP64ri $a0, 0
# CHECK-NEXT:  JCC %bb.{{[0-9]+}}, 2

# CHECK-LABEL: name: a_reg_zero_cmp_movcc
# CHECK-NOT:   CLR64r
# CHECK-NOT:   CMP64rr
# CHECK:       CMP64ri $a0, 0
# CHECK-NEXT:  MOVCC64rr $d1, $d0, 2

# CHECK-LABEL: name: a_reg_zero_cmp_movcc_intervening
# CHECK-NOT:   CLR64r
# CHECK:       $d3 = MOV64ri 7
# CHECK-NEXT:  CMP64ri $a0, 0
# CHECK-NEXT:  MOVCC64rr $d1, $d0, 2

# CHECK-LABEL: name: callee_saved_zero_cmp_movcc_intervening
# CHECK-NOT:   CLR64r
# CHECK:       $d7 = MOV64ri 7
# CHECK-NEXT:  CMP64ri $a0, 0
# CHECK-NEXT:  MOVCC64rr $a0, $d7, 2

# CHECK-LABEL: name: callee_saved_zero_cmp_movcc_call
# CHECK-NOT:   CLR64r
# CHECK:       $d7 = MOV64ri 7
# CHECK-NEXT:  CMP64ri $a0, 0
# CHECK-NEXT:  MOVCC64rr $a0, $d7, 2

# CHECK-LABEL: name: callee_saved_zero_cmp_movcc_cfg
# CHECK-NOT:   CLR64r
# CHECK:       $d7 = MOV64ri 7
# CHECK-NEXT:  CMP64ri $a0, 0
# CHECK-NEXT:  MOVCC64rr $a0, $d7, 2

--- |
  target triple = "bedrock"

  define void @o0_clr_zero_cmp_jcc() #0 {
    ret void
  }

  define void @o0_live_zero_negative() #0 {
    ret void
  }

  define void @a_reg_zero_cmp_imm() #0 {
    ret void
  }

  define i64 @a_reg_zero_cmp_movcc() #0 {
    ret i64 0
  }

  define i64 @a_reg_zero_cmp_movcc_intervening() #0 {
    ret i64 0
  }

  define i64 @callee_saved_zero_cmp_movcc_intervening() #0 {
    ret i64 0
  }

  declare void @callee()

  define void @callee_saved_zero_cmp_movcc_call() #0 {
    ret void
  }

  define void @callee_saved_zero_cmp_movcc_cfg() #0 {
    ret void
  }

  attributes #0 = { noinline optnone }
...
---
name: o0_clr_zero_cmp_jcc
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $d0

    $d1 = CLR64r
    CMP32rr $d1, $d0, implicit-def $flags
    JCC %bb.1, 2, implicit $flags
    JMP %bb.2

  bb.1:
    RET implicit $sp

  bb.2:
    RET implicit $sp
...
---
name: a_reg_zero_cmp_imm
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $a0

    $d1 = CLR64r
    CMP64rr $a0, $d1, implicit-def $flags
    JCC %bb.1, 2, implicit $flags
    JMP %bb.2

  bb.1:
    RET implicit $sp

  bb.2:
    RET implicit $sp
...
---
name: a_reg_zero_cmp_movcc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0, $d0, $d1

    $d2 = CLR64r
    CMP64rr $d2, $a0, implicit-def $flags
    $d1 = MOVCC64rr $d1, $d0, 2, implicit $flags
    $d0 = MOV64rr $d1
    RET implicit $d0, implicit $sp
...
---
name: a_reg_zero_cmp_movcc_intervening
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0, $d0, $d1

    $d2 = CLR64r
    $d3 = MOV64ri 7
    CMP64rr $d2, $a0, implicit-def $flags
    $d1 = MOVCC64rr $d1, $d0, 2, implicit $flags
    $d0 = MOV64rr $d1
    RET implicit $d0, implicit $sp
...
---
name: callee_saved_zero_cmp_movcc_intervening
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0, $d6, $d7

    frame-setup PUSHM 192, implicit-def $sp, implicit $sp, implicit killed $d6, implicit killed $d7
    $d6 = CLR64r
    $d7 = MOV64ri 7
    CMP64rr $a0, $d6, implicit-def $flags
    $a0 = MOVCC64rr $a0, $d7, 2, implicit $flags
    frame-destroy POPM 192, implicit-def $sp, implicit $sp, implicit-def $d6, implicit-def $d7
    RET implicit $a0, implicit $sp
...
---
name: callee_saved_zero_cmp_movcc_call
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0, $d0, $d1, $d6, $d7

    frame-setup PUSHM 192, implicit-def $sp, implicit $sp, implicit killed $d6, implicit killed $d7
    $d6 = CLR64r
    $d7 = MOV64ri 7
    CMP64rr $a0, $d6, implicit-def $flags
    $a0 = MOVCC64rr $a0, $d7, 2, implicit $flags
    CALLpcrel16 @callee, csr_bedrock, implicit-def $sp, implicit $sp, implicit $d0, implicit $d1
    frame-destroy POPM 192, implicit-def $sp, implicit $sp, implicit-def $d6, implicit-def $d7
    RET implicit $sp
...
---
name: callee_saved_zero_cmp_movcc_cfg
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $a0, $d0, $d1, $d6, $d7

    frame-setup PUSHM 192, implicit-def $sp, implicit $sp, implicit killed $d6, implicit killed $d7
    $d6 = CLR64r
    $d7 = MOV64ri 7
    CMP64rr $a0, $d6, implicit-def $flags
    $a0 = MOVCC64rr $a0, $d7, 2, implicit $flags
    INC64m $a0, 16, implicit-def $flags
    $d0 = MOV64rm $a0, 0
    TEST64rr $d0, $d0, implicit-def $flags
    JCC %bb.2, 2, implicit $flags

  bb.1:
    successors: %bb.2, %bb.3
    liveins: $d0, $d7

    CMP64rr killed $d0, killed $d7, implicit-def $flags
    JCC %bb.3, 3, implicit $flags

  bb.2:
    successors: %bb.3

    CALLpcrel16 @callee, csr_bedrock, implicit-def $sp, implicit $sp

  bb.3:
    frame-destroy POPM 192, implicit-def $sp, implicit $sp, implicit-def $d6, implicit-def $d7
    RET implicit $sp
...
---
name: o0_live_zero_negative
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $d0

    $d1 = CLR64r
    CMP32rr $d1, $d0, implicit-def $flags
    JCC %bb.1, 2, implicit $flags
    JMP %bb.2

  bb.1:
    liveins: $d1

    $d0 = MOV32rr $d1
    RET implicit $sp

  bb.2:
    RET implicit $sp
...

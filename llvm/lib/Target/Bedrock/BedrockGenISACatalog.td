    bits<8> distinctOperandA, bits<8> distinctOperandB> {
  string Id = id;
  string Mnemonic = mnemonic;
  string Owner = owner;
  string Pattern = pattern;
  string Suffixes = suffixes;
  bits<8> EncodingClass = encodingClass;
